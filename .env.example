# Copy values into your local shell before starting the backend.
JWT_SECRET=replace-with-a-random-secret-at-least-32-characters
TOKEN_MINUTES=60
DATABASE_URL=sqlite:///./backend/careconnect.db
FRONTEND_ORIGINS=http://localhost:5173
MAX_REPORT_BYTES=10485760
# Required only for Vercel production. Create this as a private PDF-only bucket first.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_STORAGE_BUCKET=private-health-reports
# Optional: only localhost Ollama is supported; leave model blank to use local rules/retrieval.
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=
